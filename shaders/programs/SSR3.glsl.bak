vec3 rayPos = viewPos;
vec3 rayDir = reflectedViewDir * 0.5; // step size

vec3 hitColor = color.rgb; // fallback
for(int i = 0; i < 64; i++) {
    rayPos += rayDir;

    vec3 screenPos = projectAndDivide(gbufferProjection, rayPos) * 0.5 + 0.5;

    if(screenPos.x < 0.0 || screenPos.x > 1.0 || screenPos.y < 0.0 || screenPos.y > 1.0) break;

    float sampleDepth = texture(depthtex0, screenPos.xy).r;
    float rayDepth = screenPos.z;

    if(rayDepth > sampleDepth && rayDepth - sampleDepth < 0.01) {
        hitColor = texture(colortex0, screenPos.xy).rgb;
        break;
    }
}
color.rgb = hitColor;
